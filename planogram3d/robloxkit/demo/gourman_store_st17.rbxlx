			<Item class="LocalScript" referent="RBX114">
				<Properties>
					<string name="Name">AnnounceClient</string>
					<ProtectedString name="Source"><![CDATA[-- Всплывающие объявления тренажёра (сгенерировано planogram3d)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local announce = ReplicatedStorage:WaitForChild("Announce")
local gui = script.Parent
local frame = gui:WaitForChild("Toast")
local label = frame:WaitForChild("Text")
local queue = {}
local busy = false

local function show()
	if busy then return end
	local text = table.remove(queue, 1)
	if not text then return end
	busy = true
	label.Text = text
	frame.Visible = true
	task.delay(3, function()
		frame.Visible = false
		busy = false
		show()
	end)
end

announce.OnClientEvent:Connect(function(text)
	table.insert(queue, text)
	show()
end)
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
